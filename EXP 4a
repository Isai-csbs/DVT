import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# Load the Netflix dataset
df = pd.read_csv("netflix_titles.csv")

# Extract numeric runtime duration for movies
df["duration_num"] = pd.to_numeric(
    df["duration"].str.extract(r"(\d+)")[0], errors="coerce"
)

# 1. Dataset Inspection
print("--- Full DataFrame ---")
print(df)
print("\n--- First 5 Rows ---")
print(df.head())
print("\n--- Shape (Rows, Columns) ---")
print(df.shape)
print("\n--- Data Types ---")
print(df.dtypes)
print("\n--- Summary Statistics ---")
print(df.describe())

# 2. Filtering
print("\n--- Recent Content (Release Year > 2018) ---")
print(df[df["release_year"] > 2018])
print("\n--- Movies Only ---")
print(df[df["type"] == "Movie"])

# 3. Sorting
print("\n--- Sorted by Release Year (Descending) ---")
print(df.sort_values("release_year", ascending=False))
print("\n--- Sorted by Title (Alphabetical) ---")
print(df.sort_values("title", ascending=True))

# 4. Grouping & Aggregations
print("\n--- Mean Release Year by Content Type ---")
print(df.groupby("type")["release_year"].mean())
print("\n--- Mean Release Year by Top Ratings ---")
print(df.groupby("rating")["release_year"].mean().head(10))

# 5. Statistical Calculations
print("\n--- Summary Stats for Release Year ---")
print("Mean Release Year:", df["release_year"].mean())
print("Median Release Year:", df["release_year"].median())
print("Minimum Release Year:", df["release_year"].min())
print("Maximum Release Year:", df["release_year"].max())
print("Standard Deviation:", df["release_year"].std())

# 6. Correlation Analysis
print("\n--- Correlation Matrix ---")
print(df[["release_year", "duration_num"]].corr())
print(
    "Correlation (Release Year vs Movie Duration):",
    df["release_year"].corr(df["duration_num"]),
)

# ---------------------------------------------------------
# VISUALIZATIONS
# ---------------------------------------------------------

# 1. Bar Chart: Content Type Breakdown (Movies vs TV Shows)
type_count = df["type"].value_counts()
plt.bar(type_count.index, type_count.values, color=["#E50914", "#221F1F"])
plt.title("Movies vs TV Shows on Netflix")
plt.xlabel("Content Type")
plt.ylabel("Number of Titles")
plt.show()

# 2. Bar Chart: Top 10 Ratings
rating_count = df["rating"].value_counts().head(10)
plt.bar(rating_count.index, rating_count.values, color="skyblue")
plt.title("Top 10 Netflix Age Ratings")
plt.xlabel("Rating")
plt.ylabel("Number of Titles")
plt.xticks(rotation=45)
plt.show()

# 3. Scatter Plot: Release Year vs Movie Duration
movie_df = df[df["type"] == "Movie"].dropna(
    subset=["release_year", "duration_num"]
)
plt.scatter(movie_df["release_year"], movie_df["duration_num"], alpha=0.5)
plt.title("Release Year vs Movie Duration")
plt.xlabel("Release Year")
plt.ylabel("Duration (Minutes)")
plt.show()

# 4. Histogram: Distribution of Release Years
plt.hist(df["release_year"].dropna(), bins=25, edgecolor="black")
plt.title("Distribution of Netflix Release Years")
plt.xlabel("Release Year")
plt.ylabel("Number of Titles")
plt.show()

# 5. Box Plot: Release Year by Content Type
movies_years = df[df["type"] == "Movie"]["release_year"].dropna()
tv_years = df[df["type"] == "TV Show"]["release_year"].dropna()

plt.boxplot([movies_years, tv_years], labels=["Movie", "TV Show"])
plt.title("Release Year Distribution by Content Type")
plt.ylabel("Release Year")
plt.show()
